# Copier vers .env.production à la racine du dépôt, sur le VPS. Jamais commité.

# Domaine servi en HTTPS par Caddy. Le DNS doit pointer vers le VPS.
DOMAINE=app.exemple.ci

# Mot de passe de la base PostgreSQL de la pile. Générer :
#   openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# Clé de signature des sessions (48 octets aléatoires au moins). Générer :
#   openssl rand -base64 48 | tr -d '/+='
AUTH_SECRET=

DEFAULT_COUNTRY=CI

# Instance réelle : pas de bandeau de démonstration, aucun module sur jeu d'essai.
INSTANCE_DEMO=0
MODULES_APERCU=

# Adresse publique de l'application, pour les liens envoyés par e-mail.
URL_PUBLIQUE=https://app.exemple.ci

# Envoi des e-mails (mot de passe oublié). Voir DEPLOIEMENT.md.
#   COURRIEL_FOURNISSEUR=brevo   avec COURRIEL_CLE = clé API Brevo
#   COURRIEL_FOURNISSEUR=resend  avec COURRIEL_CLE = clé API Resend
# Vide : les liens de réinitialisation sont seulement écrits dans le journal.
COURRIEL_FOURNISSEUR=
COURRIEL_CLE=
COURRIEL_EXPEDITEUR=Maria Suite <no-reply@exemple.ci>

# Sauvegarde : toutes les 24 h, conservée 14 jours.
SAUVEGARDE_INTERVALLE_HEURES=24
SAUVEGARDE_JOURS=14
