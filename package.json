{
  "name": "maria-suite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "dotenv -v DATABASE_URL=pglite:./.pglite -v STOCKAGE_LOCAL=./.pglite/fichiers -- next dev",
    "build": "next build",
    "build:scripts": "esbuild src/scripts/installer.ts --bundle --platform=node --target=node22 --format=cjs --external:@node-rs/argon2 --external:@electric-sql/pglite --outfile=build/scripts/installer.cjs",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:base",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "tsx src/scripts/verifier-base.ts",
    "db:droits": "tsx src/scripts/synchroniser-droits.ts",
    "installer": "tsx src/scripts/installer.ts",
    "installer:local": "dotenv -v DATABASE_URL=pglite:./.pglite -- tsx src/scripts/installer.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:base": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "imapflow": "^2.2.5",
    "jose": "^6.2.10",
    "mailparser": "^3.9.35",
    "next": "16.3.2",
    "nodemailer": "^10.0.14",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.12.0"
}
